<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Resources\Icons\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Icons\AppIcon.ico" />
    <None Remove="XamlStylerConfig.json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Labs.Controls" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="FluentAvaloniaUI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="Svg.Skia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IconManager.Core\IconManager.Core.csproj" />
    <ProjectReference Include="..\IconManager.IconSets\IconManager.IconSets.csproj" />
  </ItemGroup>

  <Target Name="Format XAML" AfterTargets="BeforeBuild" Condition="'$(Configuration)' == 'Debug'">
    <!-- XamlStyler -->
    <Exec Command="dotnet tool install --global XamlStyler.Console" IgnoreExitCode="true" />
    <Exec Command="xstyler.exe --recursive --directory &quot;$(SolutionDir)Source\IconManager&quot; --config &quot;$(SolutionDir)Source\IconManager\XamlStylerConfig.json&quot;" IgnoreExitCode="true" />
  </Target>
</Project>
