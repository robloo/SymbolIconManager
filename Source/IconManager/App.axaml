<Application
    x:Class="IconManager.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="using:FluentAvalonia.Styling"
    RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://IconManager/Views/DataTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <IconSetUrlConverter
                x:Key="IconSetUrl" />
            <MatchQualityToBrushConverter
                x:Key="MatchQualityToBrush" />
            <UIntToHexStringConverter
                x:Key="UIntToHexString" />

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!--
            Notes on custom accent color:
            - Using this shade of teal works in both light/dark themes
            - This matches the color in the AppIcon.ico
        -->
        <fa:FluentAvaloniaTheme
            CustomAccentColor="#0F8B8D" />
    </Application.Styles>

</Application>
