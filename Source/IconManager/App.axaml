<Application
    x:Class="IconManager.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fa="using:FluentAvalonia.Styling"
    RequestedThemeVariant="Light">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://IconManager/Themes/ControlThemes.axaml" />
                <ResourceInclude Source="avares://IconManager/Themes/DataTemplates.axaml" />
                <ResourceInclude Source="avares://IconManager/Themes/Icons.axaml" />
                <ResourceInclude Source="avares://IconManager/Themes/ThemeDictionary.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <ForegroundContrastBrushConverter
                x:Key="ForegroundContrastBrush" />
            <IconSetInfoConverter
                x:Key="IconSetInfo" />
            <MatchQualityToBrushConverter
                x:Key="MatchQualityToBrush" />
            <UIntToHexStringConverter
                x:Key="UIntToHexString" />

            <x:Double x:Key="PathIconSize">16</x:Double>

        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>

        <StyleInclude Source="avares://IconManager/Themes/Styles.axaml" />

        <!--
            Notes on custom accent color:
            - Using this shade of teal works in both light/dark themes
            - This matches the color in the AppIcon.ico
        -->
        <fa:FluentAvaloniaTheme
            CustomAccentColor="#0F8B8D" />
    </Application.Styles>

</Application>
