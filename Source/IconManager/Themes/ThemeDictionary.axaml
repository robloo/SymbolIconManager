<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <!-- Note: Default is 'Light' theme, in WinUI it's 'Dark' -->
        <ResourceDictionary
            x:Key="Default">

            <SolidColorBrush
                x:Key="ToolBarBackgroundBrush"
                Color="#FFEBEBEB"
                Opacity="0.60" />
            <SolidColorBrush
                x:Key="ToolBarBorderBrush"
                Color="{StaticResource SurfaceStrokeColorDefault}"
                Opacity="0.70" />

        </ResourceDictionary>

        <ResourceDictionary
            x:Key="Dark">

            <SolidColorBrush
                x:Key="ToolBarBackgroundBrush"
                Color="#FF3C3C3C"
                Opacity="0.60" />
            <SolidColorBrush
                x:Key="ToolBarBorderBrush"
                Color="{StaticResource SurfaceStrokeColorDefault}"
                Opacity="0.70" />

        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
