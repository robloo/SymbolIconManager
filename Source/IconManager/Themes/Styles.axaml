<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Button.close">
        <Setter Property="Theme" Value="{DynamicResource TransparentButton}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Content">
            <Template>
                <PathIcon
                    Width="{StaticResource PathIconSize}"
                    Height="{StaticResource PathIconSize}"
                    Data="{StaticResource ic_fluent_dismiss_20_regular}" />
            </Template>
        </Setter>
    </Style>

    <Style Selector="Button.copy">
        <Setter Property="Theme" Value="{DynamicResource TransparentButton}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Content">
            <Template>
                <PathIcon
                    Width="{StaticResource PathIconSize}"
                    Height="{StaticResource PathIconSize}"
                    Data="{StaticResource ic_fluent_copy_20_regular}" />
            </Template>
        </Setter>
    </Style>

    <Style Selector="Button.clear-text">
        <Setter Property="Theme" Value="{DynamicResource TransparentButton}" />
        <Setter Property="Padding" Value="6,4,6,4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Content">
            <Template>
                <PathIcon
                    Width="14"
                    Height="14"
                    Data="{StaticResource ic_fluent_dismiss_20_regular}" />
            </Template>
        </Setter>
    </Style>

    <Style Selector="Border.textbox-style">
        <Setter Property="Background" Value="{DynamicResource TextControlBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TextControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
        <Setter Property="MinWidth" Value="{DynamicResource TextControlThemeMinWidth}" />
        <Setter Property="Padding" Value="{DynamicResource TextControlThemePadding}" />
    </Style>

</Styles>
