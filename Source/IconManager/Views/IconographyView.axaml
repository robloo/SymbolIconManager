<UserControl
    x:Class="IconManager.Views.IconographyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:labs="using:Avalonia.Labs.Controls"
    mc:Ignorable="d"
    x:DataType="IconographyViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <UserControl.Styles>

        <Style Selector="Button.close">
            <Setter Property="Theme" Value="{StaticResource TransparentButton}" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Content">
                <Template>
                    <Viewbox
                        Width="24"
                        Height="24"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <Path
                            Width="20"
                            Height="20"
                            Data="{StaticResource ic_fluent_dismiss_20_regular}"
                            Fill="{DynamicResource TextControlForeground}" />
                    </Viewbox>
                </Template>
            </Setter>
        </Style>

        <Style Selector="Button.copy">
            <Setter Property="Theme" Value="{StaticResource TransparentButton}" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Content">
                <Template>
                    <Viewbox
                        Width="24"
                        Height="24"
                        Stretch="Uniform"
                        StretchDirection="Both">
                        <Path
                            Width="20"
                            Height="20"
                            Data="{StaticResource ic_fluent_copy_20_regular}"
                            Fill="{DynamicResource TextControlForeground}" />
                    </Viewbox>
                </Template>
            </Setter>
        </Style>

    </UserControl.Styles>

    <Grid
        x:Name="LayoutRoot"
        RowDefinitions="Auto,*">

        <!-- Top commands -->
        <Grid
            x:Name="TopCommandBarGridGrid"
            Grid.Row="0"
            MinHeight="50"
            HorizontalAlignment="Stretch">

            <Border
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource ToolBarBackground}"
                BorderBrush="{DynamicResource ToolBarBorderBrush}"
                BorderThickness="0,1,0,1" />

            <!-- Left Commands -->
            <StackPanel
                Orientation="Horizontal"
                Margin="10,0,10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">

                <TextBox
                    Width="200"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding SelectedIconSet, Converter={x:Static ObjectConverters.IsNotNull}}"
                    PlaceholderText="Search &amp; filter icons"
                    Text="{Binding FilterText, Mode=TwoWay, Delay=200}">
                    <TextBox.InnerRightContent>
                        <Button
                            Classes="close"
                            IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding ClearFilterTextCommand}" />
                    </TextBox.InnerRightContent>
                </TextBox>

                <TextBlock
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextControlForegroundDisabled}"
                    Text="{Binding FilteredIcons.Count, StringFormat='{}{0} visible'}" />

            </StackPanel>

            <!-- Right Commands -->
            <StackPanel
                Orientation="Horizontal"
                Margin="10,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">

                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextControlForegroundDisabled}"
                    Text="Icon set" />

                <ComboBox
                    MinWidth="150"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding IconSets}"
                    SelectedItem="{Binding SelectedIconSet}" />

            </StackPanel>

        </Grid>

        <!-- Icon Gallery -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto">

            <!-- Icons -->
            <ListBox
                x:Name="IconsListBox"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ItemContainerTheme="{StaticResource IconContainerTheme}"
                ItemTemplate="{StaticResource IconDataTemplate}"
                ItemsSource="{Binding FilteredIcons}"
                SelectedItem="{Binding SelectedIcon, Mode=TwoWay}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- TODO: Replace with Avalonia.Labs VirtualizingWrapPanel when released -->
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- Selected Icon Details -->
            <Border
                Grid.Column="1"
                Width="300"
                Margin="10"
                Padding="10"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                IsVisible="{Binding SelectedIcon, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid
                    x:DataType="IconViewModel"
                    RowDefinitions="Auto,Auto,Auto,*"
                    DataContext="{Binding SelectedIcon}">

                    <!-- Close Button -->
                    <Button
                        Grid.Row="0"
                        Classes="close"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding #LayoutRoot.DataContext.ClearSelectedIconCommand}" />

                    <Image
                        Grid.Row="0"
                        Width="64"
                        Height="64"
                        Margin="20,20,20,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding Glyph}" />
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextControlForegroundDisabled}"
                        IsVisible="{Binding Glyph?.Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Run Text="Source: " /><Run Text="{Binding Glyph?.Source}" />
                    </TextBlock>
                    <HyperlinkButton
                        Grid.Row="2"
                        Margin="0,0,0,20"
                        Padding="2"
                        HorizontalAlignment="Center"
                        Content="Website"
                        NavigateUri="{Binding IconSet, Converter={StaticResource IconSetUrl}}"
                        TextElement.FontSize="12" />

                    <ScrollViewer
                        Grid.Row="3"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <Grid
                            RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                            RowSpacing="10">

                            <!-- Icon Name -->
                            <StackPanel
                                Grid.Row="0"
                                Orientation="Vertical"
                                Margin="0,0,32,0"
                                Spacing="2">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextControlForegroundDisabled}"
                                    Text="Icon name" />
                                <SelectableTextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                Grid.Row="0"
                                Classes="copy"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding #LayoutRoot.DataContext.CopyTextCommand}"
                                CommandParameter="{Binding Name}" />

                            <!-- Icon Set -->
                            <StackPanel
                                Grid.Row="1"
                                Orientation="Vertical"
                                Margin="0,0,32,0"
                                Spacing="2">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextControlForegroundDisabled}"
                                    Text="Icon set" />
                                <SelectableTextBlock
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding IconSet}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button
                                Grid.Row="1"
                                Classes="copy"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding #LayoutRoot.DataContext.CopyTextCommand}"
                                CommandParameter="{Binding IconSet}" />

                            <!-- Text Glyph -->
                            <StackPanel
                                Grid.Row="2"
                                Orientation="Vertical"
                                Margin="0,0,32,0"
                                Spacing="2">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextControlForegroundDisabled}"
                                    Text="Text glyph" />
                                <SelectableTextBlock
                                    x:Name="TextGlyphTextBlock"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding UnicodeHexString, StringFormat='&amp;#x{0};'}" />
                            </StackPanel>
                            <Button
                                Grid.Row="2"
                                Classes="copy"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding #LayoutRoot.DataContext.CopyTextCommand}"
                                CommandParameter="{Binding #TextGlyphTextBlock.Text}" />

                            <!-- Code Glyph -->
                            <StackPanel
                                Grid.Row="3"
                                Orientation="Vertical"
                                Margin="0,0,32,0"
                                Spacing="2">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextControlForegroundDisabled}"
                                    Text="Code glyph" />
                                <SelectableTextBlock
                                    x:Name="CodeGlyphTextBlock"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="{Binding UnicodeHexString, StringFormat='\\u{0}'}" />
                            </StackPanel>
                            <Button
                                Grid.Row="3"
                                Classes="copy"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Command="{Binding #LayoutRoot.DataContext.CopyTextCommand}"
                                CommandParameter="{Binding #CodeGlyphTextBlock.Text}" />

                            <!-- Path Data -->
                            <StackPanel
                                Grid.Row="4"
                                Orientation="Vertical"
                                Margin="0,0,32,0"
                                IsVisible="{Binding Glyph?.PathData, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Spacing="2">
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextControlForegroundDisabled}"
                                    IsVisible="{Binding Glyph?.Source, Converter={x:Static ObjectConverters.IsNull}}"
                                    Text="Path data" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextControlForegroundDisabled}"
                                    IsVisible="{Binding Glyph?.Source, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Run Text="Path data (" /><Run Text="{Binding Glyph?.Source}" /><Run Text=")" />
                                </TextBlock>
                                <ScrollViewer
                                    MaxHeight="200"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <SelectableTextBlock
                                        FontSize="10"
                                        FontWeight="SemiBold"
                                        Text="{Binding Glyph?.PathData}"
                                        TextWrapping="Wrap" />
                                </ScrollViewer>
                            </StackPanel>
                            <Button
                                Grid.Row="4"
                                Classes="copy"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                IsVisible="{Binding Glyph?.PathData, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Command="{Binding #LayoutRoot.DataContext.CopyTextCommand}"
                                CommandParameter="{Binding Glyph?.PathData}" />

                            <!-- Preview Path Data -->
                            <StackPanel
                                Grid.Row="5"
                                Orientation="Vertical"
                                HorizontalAlignment="Center"
                                IsVisible="{Binding Glyph?.PathData, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Spacing="2">
                                <Panel>
                                    <Rectangle
                                        Width="{Binding Glyph?.PathViewBox?.Width}"
                                        Height="{Binding Glyph?.PathViewBox?.Height}"
                                        Stroke="{DynamicResource TextControlForegroundDisabled}"
                                        StrokeDashArray="4, 2"
                                        StrokeThickness="1" />
                                    <Path
                                        Width="{Binding Glyph?.PathViewBox?.Width}"
                                        Height="{Binding Glyph?.PathViewBox?.Height}"
                                        Data="{Binding Glyph?.PathData}"
                                        Fill="{DynamicResource TextControlForeground}" />
                                </Panel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextControlForegroundDisabled}"
                                    IsVisible="{Binding Glyph?.PathData, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Run Text="w: " /><Run Text="{Binding Glyph?.PathViewBox?.Width}" /><Run Text=" × h: " /><Run Text="{Binding Glyph?.PathViewBox?.Height}" />
                                </TextBlock>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>

            </Border>
        </Grid>

    </Grid>

</UserControl>
