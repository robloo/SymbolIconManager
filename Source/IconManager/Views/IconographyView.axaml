<UserControl
    x:Class="IconManager.Views.IconographyView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DataType="IconographyViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <Grid
        RowDefinitions="Auto,*"
        Margin="10">

        <ComboBox
            Grid.Row="0"
            ItemsSource="{Binding IconSets}"
            SelectedItem="{Binding SelectedIconSet}" />

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <TextBlock
                Margin="0,0,5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{Binding FilteredIcons.Count, StringFormat='Count: {0}'}" />
            <TextBox
                x:Name="FilterTextBox"
                Width="200"
                PlaceholderText="Filter"
                Text="{Binding FilterText, Mode=TwoWay, Delay=200}" />
        </StackPanel>

        <ListBox
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ItemTemplate="{StaticResource IconDataTemplate}"
            ItemsSource="{Binding FilteredIcons}" />
    </Grid>
</UserControl>
