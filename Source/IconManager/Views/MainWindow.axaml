<Window
    x:Class="IconManager.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DataType="ShellViewModel"
    Title="Symbol Icon Manager"
    Width="1440"
    Height="900"
    MinWidth="800"
    MinHeight="600"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Icon="/Resources/Icons/AppIcon.ico">

    <Grid
        x:Name="LayoutRoot">
        <TabControl
            Padding="0">

            <!-- Iconography -->
            <TabItem
                Header="{Localize MainWindow_IconographyText}"
                IsSelected="True">
                <IconographyView>
                    <IconographyView.DataContext>
                        <IconographyViewModel />
                    </IconographyView.DataContext>
                </IconographyView>
            </TabItem>

            <!-- Icon Mapping -->
            <TabItem
                Header="{Localize MainWindow_IconMappingText}">
                <MappingEditorView>
                    <MappingEditorView.DataContext>
                        <MappingEditorViewModel />
                    </MappingEditorView.DataContext>
                </MappingEditorView>
            </TabItem>

            <!-- Application Tools -->
            <TabItem
                Header="{Localize MainWindow_AppToolsText}">
                <AppToolsView>
                    <AppToolsView.DataContext>
                        <AppToolsViewModel />
                    </AppToolsView.DataContext>
                </AppToolsView>
            </TabItem>

            <!-- Font Builder -->
            <TabItem
                Header="{Localize MainWindow_FontBuilderText}">
                <FontBuilderView>
                    <FontBuilderView.DataContext>
                        <FontBuilderViewModel />
                    </FontBuilderView.DataContext>
                </FontBuilderView>
            </TabItem>
        </TabControl>

        <Button
            Margin="10"
            Padding="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding ToggleThemeVariantCommand}">
            <Button.Content>
                <PathIcon
                    Width="20"
                    Height="20"
                    Data="{StaticResource LightDarkSunGeometry}" />
            </Button.Content>
        </Button>
    </Grid>

</Window>
