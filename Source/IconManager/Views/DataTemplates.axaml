<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DataTemplate
        x:Key="IconDataTemplate"
        x:DataType="IconViewModel">
        <Grid
            ColumnDefinitions="Auto,Auto,*">
            <Image
                Grid.Column="0"
                Width="50"
                Height="50"
                Source="{Binding Glyph}" />
            <TextBlock
                Grid.Column="1"
                Margin="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                Text="{Binding UnicodeHexString}" />
            <TextBlock
                Grid.Column="2"
                Margin="5"
                VerticalAlignment="Center"
                Text="{Binding Name}" />
        </Grid>
    </DataTemplate>

</ResourceDictionary>
