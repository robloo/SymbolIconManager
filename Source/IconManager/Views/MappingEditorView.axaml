<UserControl
    x:Class="IconManager.Views.MappingEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DataType="MappingEditorViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <Grid
        x:Name="LayoutRoot"
        RowDefinitions="Auto,*">

        <!-- Top commands -->
        <Grid
            x:Name="TopCommandBarGrid"
            Grid.Row="0"
            MinHeight="50"
            HorizontalAlignment="Stretch">

            <Border
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource ToolBarBackground}"
                BorderBrush="{DynamicResource ToolBarBorderBrush}"
                BorderThickness="0,1,0,1" />

            <!-- Left Commands -->
            <StackPanel
                Orientation="Horizontal"
                Margin="10,0,10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">

                <TextBox
                    Width="250"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding !!Mappings.Count}"
                    PlaceholderText="{Localize Key=MappingEditorView_FilterText, FallbackValue='&lt;missing&gt;'}"
                    Text="{Binding FilterText, Mode=TwoWay, Delay=200}">
                    <TextBox.InnerRightContent>
                        <Button
                            Classes="close"
                            Padding="8,4,8,4"
                            IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Command="{Binding ClearFilterTextCommand}" />
                    </TextBox.InnerRightContent>
                </TextBox>

                <TextBlock
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextControlForegroundDisabled}">
                    <Run Text="{Binding FilteredMappings.Count}" />
                    <Run Text="{Localize Key=MappingEditorView_VisibleText, FallbackValue='&lt;missing&gt;'}" />
                </TextBlock>

            </StackPanel>

            <!-- Right Commands -->
            <StackPanel
                Orientation="Horizontal"
                Margin="10,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">

                <SplitButton
                    MinWidth="100"
                    HorizontalContentAlignment="Center"
                    Command="{Binding OpenMappingsCommand}">
                    <SplitButton.Content>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4">
                            <PathIcon
                                Width="{StaticResource PathIconSize}"
                                Height="{StaticResource PathIconSize}"
                                Data="{StaticResource ic_fluent_folder_20_regular}" />
                            <TextBlock
                                Text="{Localize Key=MappingEditorView_OpenMappingsText, FallbackValue='&lt;missing&gt;'}" />
                        </StackPanel>
                    </SplitButton.Content>
                    <SplitButton.Flyout>
                        <MenuFlyout
                            Placement="BottomEdgeAlignedLeft">
                            <MenuItem
                                Header="SegoeFluent.json"
                                Command="{Binding LoadMappingsCommand}"
                                CommandParameter="SegoeFluent.json" />
                            <MenuItem
                                Header="FluentAvalonia.json"
                                Command="{Binding LoadMappingsCommand}"
                                CommandParameter="FluentAvalonia.json" />
                            <MenuItem
                                Header="-" />
                            <MenuItem
                                Header="FluentUISystemToSegoeMDL2Assets.json"
                                Command="{Binding LoadMappingsCommand}"
                                CommandParameter="FluentUISystemToSegoeMDL2Assets.json" />
                            <MenuItem
                                Header="SegoeUISymbolToSegoeMDL2Assets.json"
                                Command="{Binding LoadMappingsCommand}"
                                CommandParameter="SegoeUISymbolToSegoeMDL2Assets.json" />
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>

                <Button
                    MinWidth="100"
                    Margin="5,0,0,0"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{Binding !!Mappings.Count}"
                    Command="{Binding SaveMappingsCommand}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4">
                        <PathIcon
                            Width="{StaticResource PathIconSize}"
                            Height="{StaticResource PathIconSize}"
                            Data="{StaticResource ic_fluent_save_20_regular}" />
                        <TextBlock
                            Text="{Localize Key=MappingEditorView_SaveMappingsText, FallbackValue='&lt;missing&gt;'}" />
                    </StackPanel>
                </Button>

                <Button
                    MinWidth="100"
                    Margin="5,0,0,0"
                    HorizontalContentAlignment="Center"
                    IsEnabled="{Binding !!Mappings.Count}"
                    Command="{Binding ClearMappingsCommand}">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="4">
                        <PathIcon
                            Width="{StaticResource PathIconSize}"
                            Height="{StaticResource PathIconSize}"
                            Data="{StaticResource ic_fluent_eraser_20_regular}" />
                        <TextBlock
                            Text="{Localize Key=MappingEditorView_ClearMappingsText, FallbackValue='&lt;missing&gt;'}" />
                    </StackPanel>
                </Button>

                <Button
                    Margin="20,0,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center">
                    <Button.Content>
                        <PathIcon
                            Width="{StaticResource PathIconSize}"
                            Height="{StaticResource PathIconSize}"
                            Data="{StaticResource ic_fluent_more_horizontal_20_regular}" />
                    </Button.Content>
                    <Button.Flyout>
                        <MenuFlyout
                            Placement="BottomEdgeAlignedLeft">
                            <MenuItem
                                Header="{Localize Key=MappingEditorView_MergeInText, FallbackValue='&lt;missing&gt;'}"
                                Command="{Binding MergeInMappingsCommand}">
                                <MenuItem.Icon>
                                    <PathIcon
                                        Data="{StaticResource ic_fluent_arrow_join_20_regular}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Header="{Localize Key=MappingEditorView_UpdateDeprecatedIconsText, FallbackValue='&lt;missing&gt;'}"
                                IsEnabled="{Binding !!Mappings.Count}"
                                Command="{Binding UpdateDeprecatedIconsCommand}">
                                <MenuItem.Icon>
                                    <PathIcon
                                        Data="{StaticResource ic_fluent_arrow_repeat_all_20_regular}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Header="-" />
                            <MenuItem
                                Header="{Localize Key=MappingEditorView_BuildFontText, FallbackValue='&lt;missing&gt;'}"
                                IsEnabled="{Binding !!Mappings.Count}"
                                Command="{Binding BuildFontCommand}">
                                <MenuItem.Icon>
                                    <PathIcon
                                        Data="{StaticResource ic_fluent_text_font_20_regular}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

            </StackPanel>

        </Grid>

        <ListBox
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ItemsSource="{Binding FilteredMappings}">
            <ListBox.ItemTemplate>
                <DataTemplate
                    DataType="IconMappingViewModel">
                    <Border
                        Classes.incomplete="{Binding IsIncomplete}"
                        Margin="0,2,0,2"
                        Padding="4"
                        BorderBrush="{DynamicResource GroupBoxBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="Border.incomplete">
                                <Setter Property="Background" Value="#1FEB1000" />
                            </Style>
                        </Border.Styles>
                        <Grid
                            RowDefinitions="Auto,Auto"
                            ColumnDefinitions="Auto,*">

                            <!-- Source Icon -->
                            <GroupBox
                                Grid.Row="0"
                                Grid.Column="0"
                                Header="Source">
                                <Grid
                                    RowDefinitions="1*,32"
                                    ColumnDefinitions="Auto,10,300,100">
                                    <Image
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Width="50"
                                        Height="50"
                                        Margin="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{Binding SourceViewModel.Glyph}" />
                                    <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="4,0,0,4"
                                        ItemsSource="{Binding SourceViewModel.IconSets}"
                                        SelectedItem="{Binding SourceViewModel.IconSet, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="0,4,4,0"
                                        Text="{Binding SourceViewModel.UnicodePoint, Mode=TwoWay, Converter={StaticResource UIntToHexString}}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Grid.ColumnSpan="2"
                                        Margin="5,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding !IsSourceNameEditable}"
                                        Text="{Binding SourceViewModel.Name}" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Grid.ColumnSpan="2"
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Stretch"
                                        IsVisible="{Binding IsSourceNameEditable}"
                                        Text="{Binding SourceViewModel.Name, Mode=TwoWay}" />
                                </Grid>
                            </GroupBox>

                            <!-- Destination Icon -->
                            <GroupBox
                                Grid.Row="1"
                                Grid.Column="0"
                                Header="Destination">
                                <Grid
                                    RowDefinitions="1*,32"
                                    ColumnDefinitions="Auto,10,300,100">
                                    <Image
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Width="50"
                                        Height="50"
                                        Margin="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Source="{Binding DestinationViewModel.Glyph}" />
                                    <ComboBox
                                        Grid.Row="0"
                                        Grid.Column="2"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="4,0,0,4"
                                        ItemsSource="{Binding DestinationViewModel.IconSets}"
                                        SelectedItem="{Binding DestinationViewModel.IconSet, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Row="0"
                                        Grid.Column="3"
                                        HorizontalAlignment="Stretch"
                                        CornerRadius="0,4,4,0"
                                        Text="{Binding DestinationViewModel.UnicodePoint, Mode=TwoWay, Converter={StaticResource UIntToHexString}}" />
                                    <TextBlock
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Grid.ColumnSpan="2"
                                        Margin="5,0,0,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding !IsDestinationNameEditable}"
                                        Text="{Binding DestinationViewModel.Name}" />
                                    <TextBox
                                        Grid.Row="1"
                                        Grid.Column="2"
                                        Grid.ColumnSpan="2"
                                        Margin="0,2,0,0"
                                        HorizontalAlignment="Stretch"
                                        IsVisible="{Binding IsDestinationNameEditable}"
                                        Text="{Binding DestinationViewModel.Name, Mode=TwoWay}" />
                                </Grid>
                            </GroupBox>

                            <!-- Metadata -->
                            <Grid
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Grid.ColumnDefinitions="175,175,175"
                                Grid.RowDefinitions="Auto,Auto,Auto,*">
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="GlyphMatchQuality" />
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    HorizontalAlignment="Stretch"
                                    Background="{Binding GlyphMatchQuality, Mode=OneWay, Converter={StaticResource MatchQualityToBrush}}"
                                    ItemsSource="{Binding GlyphMatchQualityOptions}"
                                    SelectedItem="{Binding GlyphMatchQuality, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    Text="MetaphorMatchQuality" />
                                <ComboBox
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Background="{Binding MetaphorMatchQuality, Mode=OneWay, Converter={StaticResource MatchQualityToBrush}}"
                                    ItemsSource="{Binding MetaphorMatchQualityOptions}"
                                    SelectedItem="{Binding MetaphorMatchQuality, Mode=TwoWay}" />
                                <CheckBox
                                    Grid.Row="0"
                                    Grid.RowSpan="3"
                                    Grid.Column="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="IsPlaceholder"
                                    IsChecked="{Binding IsPlaceholder, Mode=TwoWay}" />
                                <HyperlinkButton
                                    x:Name="MatchQualityHelpButton"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Height="15"
                                    Padding="0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    NavigateUri="https://github.com/robloo/SymbolIconManager/blob/main/Docs/IconMapping.md#match-quality-values">
                                    <HyperlinkButton.Content>
                                        <Viewbox
                                            Stretch="Uniform">
                                            <TextBlock
                                                Text="Help with MatchQuality" />
                                        </Viewbox>
                                    </HyperlinkButton.Content>
                                </HyperlinkButton>
                                <TextBox
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Margin="0,2,0,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    AcceptsReturn="True"
                                    PlaceholderText="Comments"
                                    Text="{Binding Comments, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
