<UserControl
    x:Class="IconManager.Views.AppToolsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DataType="AppToolsViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <Grid
        x:Name="LayoutRoot"
        RowDefinitions="Auto,*">

        <!-- Top commands -->
        <Grid
            x:Name="TopCommandBarGrid"
            Grid.Row="0"
            MinHeight="50"
            HorizontalAlignment="Stretch">

            <Border
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource ToolBarBackground}"
                BorderBrush="{DynamicResource ToolBarBorderBrush}"
                BorderThickness="0,1,0,1" />

            <!-- Left Commands -->
            <StackPanel
                Orientation="Horizontal"
                Margin="10,0,10,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center">

                <Button
                    Height="{Binding #SourceDirectoryTextBox.Bounds.Height}"
                    Padding="8,4,8,4"
                    VerticalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    CornerRadius="4,0,0,4"
                    ToolTip.Tip="{Localize Key=AppToolsView_SelectSourceDirectoryToolTipText, FallbackValue='&lt;missing&gt;'}"
                    Command="{Binding SelectSourceDirectoryCommand}">
                    <PathIcon
                        Width="{StaticResource PathIconSize}"
                        Height="{StaticResource PathIconSize}"
                        Data="{StaticResource ic_fluent_folder_20_regular}" />
                </Button>
                <TextBox
                    x:Name="SourceDirectoryTextBox"
                    MinWidth="200"
                    MaxWidth="400"
                    VerticalAlignment="Center"
                    CornerRadius="0"
                    IsReadOnly="True"
                    PlaceholderText="{Localize Key=AppToolsView_SourceDirectoryPlaceholderText, FallbackValue='&lt;missing&gt;'}"
                    Text="{Binding SourceDirectory, Mode=OneWay}"
                    TextWrapping="NoWrap" />
                <ComboBox
                    Height="{Binding #SourceDirectoryTextBox.Bounds.Height}"
                    VerticalAlignment="Center"
                    CornerRadius="0,4,4,0"
                    ItemsSource="{Binding SourceIconSets}"
                    SelectedItem="{Binding SelectedSourceIconSet}"
                    ToolTip.Tip="{Localize Key=AppToolsView_SelectIconSetToolTipText, FallbackValue='&lt;missing&gt;'}" />

            </StackPanel>

            <!-- Right Commands -->
            <StackPanel
                Orientation="Horizontal"
                Margin="10,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">

                <StackPanel
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="5">

                    <TextBlock
                        Margin="0,0,5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextControlForegroundDisabled}"
                        IsVisible="{Binding !!Icons.Count}">
                        <Run Text="{Localize Key=AppToolsView_CountText}" /><Run Text="{Binding Icons.Count}" />
                    </TextBlock>
                    <Button
                        IsEnabled="{Binding SourceDirectory, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        ToolTip.Tip="{Localize Key=AppToolsView_FindIconsToolTipText, FallbackValue='&lt;missing&gt;'}"
                        Command="{Binding FindIconsCommand}">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="4">
                            <PathIcon
                                Width="{StaticResource PathIconSize}"
                                Height="{StaticResource PathIconSize}"
                                Data="{StaticResource ic_fluent_search_20_regular}" />
                            <TextBlock
                                Text="{Localize Key=AppToolsView_FindIconsText, FallbackValue='&lt;missing&gt;'}" />
                        </StackPanel>
                    </Button>

                    <!-- Disabled: Not general-purpose -->
                    <Button
                        Content="{Localize Key=AppToolsView_RemapIconsText, FallbackValue='&lt;missing&gt;'}"
                        IsVisible="False"
                        Command="{Binding RemapIconsCommand}" />

                    <!-- Disabled: Not general-purpose -->
                    <Button
                        Content="{Localize Key=AppToolsView_ExportFileToImagesText, FallbackValue='&lt;missing&gt;'}"
                        IsVisible="False"
                        Command="{Binding ExportFileToImagesCommand}" />

                    <!-- Unified Export Menu -->
                    <Button
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center">
                        <Button.Content>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4">
                                <PathIcon
                                    Width="{StaticResource PathIconSize}"
                                    Height="{StaticResource PathIconSize}"
                                    Data="{StaticResource ic_fluent_arrow_export_ltr_20_regular}" />
                                <TextBlock
                                    Text="{Localize Key=AppToolsView_ExportText, FallbackValue='&lt;missing&gt;'}" />
                            </StackPanel>
                        </Button.Content>
                        <Button.Flyout>
                            <MenuFlyout
                                Placement="BottomEdgeAlignedRight">
                                <MenuItem
                                    Header="{Localize Key=AppToolsView_ExportToMappingsText, FallbackValue='&lt;missing&gt;'}"
                                    IsEnabled="{Binding !!Icons.Count}"
                                    ToolTip.Tip="{Localize Key=AppToolsView_ExportToMappingsToolTipText, FallbackValue='&lt;missing&gt;'}"
                                    Command="{Binding ExportToMappingsCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon
                                            Data="{StaticResource ic_fluent_document_20_regular}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    Header="{Localize Key=AppToolsView_ExportToImagesText, FallbackValue='&lt;missing&gt;'}"
                                    IsEnabled="{Binding !!Icons.Count}"
                                    ToolTip.Tip="{Localize Key=AppToolsView_ExportToImagesToolTipText, FallbackValue='&lt;missing&gt;'}"
                                    Command="{Binding ExportToImagesCommand}">
                                    <MenuItem.Icon>
                                        <PathIcon
                                            Data="{StaticResource ic_fluent_image_20_regular}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>

                </StackPanel>

            </StackPanel>

        </Grid>

        <!-- Icon Gallery -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto">

            <!-- Icons -->
            <ListBox
                x:Name="ListBox"
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ItemContainerTheme="{StaticResource IconContainerTheme}"
                ItemTemplate="{StaticResource IconDataTemplate}"
                ItemsSource="{Binding Icons}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- TODO: Replace with Avalonia.Labs VirtualizingWrapPanel when released -->
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

        </Grid>

    </Grid>

</UserControl>
