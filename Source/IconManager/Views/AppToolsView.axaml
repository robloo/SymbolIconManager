<UserControl
    x:Class="IconManager.AppToolsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:IconManager"
    mc:Ignorable="d"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <Grid
        RowDefinitions="Auto,*"
        Margin="10">
        <Grid
            Grid.Row="0"
            HorizontalAlignment="Left"
            Grid.ColumnDefinitions="Auto,Auto"
            Grid.RowDefinitions="Auto,Auto,Auto">
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,5,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="Source Code:" />
            <TextBlock
                x:Name="SourcePathTextBlock"
                Grid.Row="0"
                Grid.Column="1" />
            <Button
                x:Name="SourceDirectoryButton"
                Grid.Row="1"
                Grid.Column="1"
                Content="Select Folder"
                Click="SourceDirectoryButton_Click" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,0,5,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="Source Icon Set:" />
            <ComboBox
                x:Name="SourceIconSetComboBox"
                Grid.Row="2"
                Grid.Column="1" />
        </Grid>
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="5">
            <TextBlock
                Margin="0,0,5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{Binding ListedIcons.Count, StringFormat='Count: {0}'}" />
            <Button
                x:Name="ListIconsButton"
                Content="List Used Icons"
                Click="ListIconsButton_Click" />
            <Button
                x:Name="RemapIconsButton"
                Content="Remap Icons"
                Click="RemapIconsButton_Click" />
            <Button
                x:Name="ExportToMappingsButton"
                Content="Export to Mappings"
                Click="ExportToMappingsButton_Click" />
            <Button
                x:Name="ExportToImagesButton"
                Content="Export to Images"
                Click="ExportToImagesButton_Click" />
            <Button
                x:Name="ExportFileToImagesButton"
                Content="Export File to Images"
                Click="ExportFileToImagesButton_Click" />
            <Button
                x:Name="BuildFontButton"
                Content="Build Font"
                IsEnabled="False"
                Click="BuildFontButton_Click" />
        </StackPanel>
        <ListBox
            x:Name="ListBox"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ItemsSource="{Binding ListedIcons}">
            <ListBox.ItemTemplate>
                <DataTemplate
                    DataType="local:IconViewModel">
                    <Grid
                        ColumnDefinitions="Auto,Auto,*">
                        <Image
                            Grid.Column="0"
                            Width="50"
                            Height="50"
                            Source="{Binding Glyph}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Text="{Binding UnicodeHexString}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
