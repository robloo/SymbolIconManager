<UserControl
    x:Class="IconManager.Views.AppToolsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DataType="AppToolsViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800">
    <Grid
        RowDefinitions="Auto,*"
        Margin="10">

        <Grid
            Grid.Row="0"
            HorizontalAlignment="Left"
            Grid.ColumnDefinitions="Auto,Auto"
            Grid.RowDefinitions="Auto,Auto,Auto">
            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,5,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="Source Code:" />
            <TextBlock
                Grid.Row="0"
                Grid.Column="1"
                Text="{Binding SourceDirectory, Mode=OneWay}" />
            <Button
                x:Name="SourceDirectoryButton"
                Grid.Row="1"
                Grid.Column="1"
                Content="Select Folder"
                Command="{Binding SelectSourceDirectoryCommand}" />
            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Margin="0,0,5,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Text="{Binding SelectedSourceIconSet, StringFormat='Source Icon Set: {0}'}" />
            <ComboBox
                x:Name="SourceIconSetComboBox"
                Grid.Row="2"
                Grid.Column="1"
                ItemsSource="{Binding SourceIconSets}"
                SelectedItem="{Binding SelectedSourceIconSet}" />
        </Grid>

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="5">
            <TextBlock
                Margin="0,0,5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{Binding DisplayedIcons.Count, StringFormat='Count: {0}'}" />
            <Button
                x:Name="ListIconsButton"
                Content="List Used Icons"
                Command="{Binding ListIconsCommand}" />
            <Button
                x:Name="RemapIconsButton"
                Content="Remap Icons"
                Command="{Binding RemapIconsCommand}" />
            <Button
                x:Name="ExportToMappingsButton"
                Content="Export to Mappings"
                Command="{Binding ExportToMappingsCommand}" />
            <Button
                x:Name="ExportToImagesButton"
                Content="Export to Images"
                Command="{Binding ExportToImagesCommand}" />
            <Button
                x:Name="ExportFileToImagesButton"
                Content="Export File to Images"
                Command="{Binding ExportFileToImagesCommand}" />
        </StackPanel>

        <ListBox
            x:Name="ListBox"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ItemsSource="{Binding DisplayedIcons}">
            <ListBox.ItemTemplate>
                <DataTemplate
                    DataType="IconViewModel">
                    <Grid
                        ColumnDefinitions="Auto,Auto,*">
                        <Image
                            Grid.Column="0"
                            Width="50"
                            Height="50"
                            Source="{Binding Glyph}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Text="{Binding UnicodeHexString}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
