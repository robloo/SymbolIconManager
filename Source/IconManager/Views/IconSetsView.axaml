<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="800"
             d:DesignHeight="450"
             x:Class="IconManager.Views.IconSetsView"
             x:DataType="IconSetsViewModel">

    <Grid Margin="10"
          RowDefinitions="Auto,*">

        <ComboBox Grid.Row="0"
                  ItemsSource="{Binding IconSets}"
                  SelectedItem="{Binding SelectedIconSet}" />

        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    HorizontalAlignment="Right">
            <TextBlock Text="{Binding FilteredIcons.Count, StringFormat='Count: {0}'}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0" />
            <TextBox x:Name="FilterTextBox"
                     Text="{Binding FilterText, Mode=TwoWay, Delay=200}"
                     PlaceholderText="Filter"
                     Width="200" />
        </StackPanel>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding FilteredIcons}"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="IconViewModel">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <Image Grid.Column="0"
                               Width="50"
                               Height="50"
                               Source="{Binding Glyph}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding UnicodeHexString}"
                                   HorizontalAlignment="Stretch"
                                   Margin="5"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   Margin="5" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
