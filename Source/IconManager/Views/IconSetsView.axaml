<UserControl
    x:Class="IconManager.Views.IconSetsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:DataType="IconSetsViewModel"
    d:DesignHeight="450"
    d:DesignWidth="800">

    <Grid
        RowDefinitions="Auto,*"
        Margin="10">

        <ComboBox
            Grid.Row="0"
            ItemsSource="{Binding IconSets}"
            SelectedItem="{Binding SelectedIconSet}" />

        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Right">
            <TextBlock
                Margin="0,0,5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="{Binding FilteredIcons.Count, StringFormat='Count: {0}'}" />
            <TextBox
                x:Name="FilterTextBox"
                Width="200"
                PlaceholderText="Filter"
                Text="{Binding FilterText, Mode=TwoWay, Delay=200}" />
        </StackPanel>

        <ListBox
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            ItemsSource="{Binding FilteredIcons}">
            <ListBox.ItemTemplate>
                <DataTemplate
                    x:DataType="IconViewModel">
                    <Grid
                        ColumnDefinitions="Auto,Auto,*">
                        <Image
                            Grid.Column="0"
                            Width="50"
                            Height="50"
                            Source="{Binding Glyph}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="5"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Text="{Binding UnicodeHexString}" />
                        <TextBlock
                            Grid.Column="2"
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="{Binding Name}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
